classDiagram
    %% ===================================================
    %% DIAGRAMA DE CLASES DEL DOMINIO - BIKESYSTEM
    %% ===================================================

    class Usuario {
        +int id_usuario
        +string nombre_usuario
        +string contrasena
        +string rol
        +Date created_at
        +autenticar(password) boolean
        +tienePermiso(modulo) boolean
    }

    class Cliente {
        +int id_cliente
        +string nombre
        +string apellido
        +string dni
        +string telefono
        +string email
        +string direccion
        +esConsumidorFinal() boolean
        +obtenerHistorial() Venta[]
    }

    class Bicicleta {
        +int id_bicicleta
        +int id_cliente
        +string marca
        +string modelo
        +consultarHistoriaClinica() Reparacion[]
    }

    class Producto {
        +int id_producto
        +string nombre
        +string marca
        +string modelo
        +string tipo_prod
        +int cantidad
        +decimal precio
        +int stock_minimo
        +boolean activo
        +hayStock(cantidad) boolean
        +descontarStock(cantidad) void
        +restituirStock(cantidad) void
    }

    class ProductoBiciNueva {
        +string color
        +string rodado
        +string talle
        +string genero
    }

    class Venta {
        +int id_venta
        +int id_cliente
        +int id_usuario
        +int id_metodo_pago
        +Date fecha
        +decimal costo_total
        +string estado
        +string motivo_anulacion
        +calcularTotal() decimal
        +anularVenta(motivo, admin) void
        +emitirComprobantePDF() void
    }

    class DetalleVenta {
        +int id_detalle_venta
        +int id_venta
        +int id_producto
        +int cantidad
        +decimal precio_unitario
        +decimal costo_total
        +boolean primer_service_realizado
        +Date fecha_primer_service
        +string observaciones_service
        +int id_usuario_service
        +boolean service_excepcion
        +estaEnGarantia() boolean
        +registrarPrimerService(tecnico) void
    }

    class Reparacion {
        +int id_reparacion
        +int id_bicicleta
        +int id_usuario
        +Date fecha_ingreso
        +Date fecha_egreso
        +string estado
        +string descripcion
        +decimal costo_mano_obra
        +decimal costo_total
        +avanzarEstadoKanban(nuevoEstado) void
        +imputarRepuesto(repuesto, cant) void
        +calcularCostoTotal() decimal
    }

    class DetalleReparacion {
        +int id_detalle_rep
        +int id_reparacion
        +int id_producto
        +int cantidad
        +decimal precio_unitario
        +decimal costo_total
        +calcularSubtotal() decimal
    }

    class MetodoPago {
        +int id_metodo_pago
        +string nombre
    }

    class Proveedor {
        +int id_proveedor
        +string nombre_empresa
        +string cuit
        +string telefono
        +string email
        +string direccion
        +validarCuit() boolean
    }

    class PagoProveedor {
        +int id_pago
        +int id_proveedor
        +int id_usuario
        +int id_metodo_pago
        +Date fecha
        +decimal monto_total
        +string observaciones
        +registrarEgreso() void
    }

    class MovimientoStock {
        +int id_movimiento
        +int id_producto
        +int id_usuario
        +string tipo_movimiento
        +int cantidad
        +string motivo
        +string observaciones
        +asentarKardex() void
    }

    class BitacoraActividad {
        +int id_bitacora
        +int id_usuario
        +string nombre_usuario
        +string modulo
        +string accion
        +string descripcion
        +Date created_at
        +registrarLog() void
    }

    %% ===================================================
    %% RELACIONES ENTRE CLASES
    %% ===================================================
    Producto <|-- ProductoBiciNueva : especialización
    Cliente "1" *-- "0..*" Bicicleta : posee
    Cliente "1" --> "0..*" Venta : compra
    Venta "1" *-- "1..*" DetalleVenta : contiene
    Reparacion "1" *-- "0..*" DetalleReparacion : insume
    Bicicleta "1" --> "0..*" Reparacion : ingresa_a

    Producto "1" --> "0..*" DetalleVenta : comercializado
    Producto "1" --> "0..*" DetalleReparacion : utilizado
    Producto "1" --> "0..*" MovimientoStock : registrado_en

    Proveedor "1" --> "0..*" PagoProveedor : percibe
    MetodoPago "1" --> "0..*" Venta : cancela
    MetodoPago "1" --> "0..*" PagoProveedor : medio_de_pago

    Usuario "1" --> "0..*" Venta : registra
    Usuario "1" --> "0..*" Reparacion : asignado
    Usuario "1" --> "0..*" PagoProveedor : autoriza
    Usuario "1" --> "0..*" MovimientoStock : opera
    Usuario "1" --> "0..*" BitacoraActividad : produce
    Usuario "0..1" --> "0..*" DetalleVenta : atendio_service
