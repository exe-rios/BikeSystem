flowchart LR
    %% Definicion de Actores del Negocio
    subgraph Actores["Actores del Sistema"]
        direction TB
        Superadmin["Superadministrador<br><b>(Dueño General)</b>"]
        Admin["Administrador<br><b>(Encargado de Salón)</b>"]
        Empleado["Empleado<br><b>(Vendedor / Mecánico)</b>"]
    end

    %% Nucleo del Sistema
    subgraph Frontera["Frontera del Sistema Desktop"]
        Sistema["<b>BikeSystem Desktop</b><br><br>• Frontend: React 19 + TypeScript + Electron 42<br>• Backend: API REST Express 5 + Node.js<br>• Control de Acceso Basado en Roles (RBAC)<br>• Reglas de Negocio, Kardex y Taller Kanban"]
    end

    %% Servicios y Periféricos Externos
    subgraph Externos["Infraestructura y Salidas"]
        direction TB
        Supabase[("<b>PostgreSQL 16+ (Supabase Cloud)</b><br>Persistencia Relacional / Pooler SSL<br>Transacciones ACID y Bloqueo Pesimista")]
        Archivos["<b>Sistema de Archivos Local (Windows)</b><br>• Comprobantes de Venta en PDF (FAC-XXXXXX)<br>• Reportes Analíticos (PDF / CSV)<br>• Copias de Seguridad SQL Nativo (Backup)"]
        Impresora["<b>Impresoras de Sistema</b><br>Impresión directa de Tickets y Comprobantes"]
    end

    %% Relaciones Actores -> Sistema
    Superadmin -->|"Administración de usuarios,<br>auditoría y backup SQL"| Sistema
    Admin -->|"Supervisión de inventario,<br>proveedores y anulación"| Sistema
    Empleado -->|"Ventas, atención de taller<br>y registro de rodados"| Sistema

    %% Relaciones Sistema -> Externos
    Sistema -->|"Consultas SQL parametrizadas<br>conexión cifrada TLS/SSL"| Supabase
    Sistema -->|"Generación y descarga<br>de documentos locales"| Archivos
    Sistema -->|"Envío de trabajos<br>a cola de impresión"| Impresora

