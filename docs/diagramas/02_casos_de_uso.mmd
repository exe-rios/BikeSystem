flowchart LR
    %% Definicion de Actores del Negocio
    subgraph Actores["Actores del Sistema"]
        direction TB
        ActSuperadmin["<b>Superadministrador</b><br>(Dueño General)"]
        ActAdmin["<b>Administrador</b><br>(Encargado de Salón)"]
        ActEmpleado["<b>Empleado</b><br>(Vendedor / Mecánico)"]
        
        ActSuperadmin -.->|"hereda permisos"| ActAdmin
        ActAdmin -.->|"hereda permisos"| ActEmpleado
    end

    %% Paquetes del Sistema
    subgraph Sistema["Frontera del Sistema: BikeSystem"]
        
        subgraph ModVentas["Subsistema 1: Ventas y Facturación"]
            direction TB
            CU_Venta(["CU09: Registrar Venta Atómica"])
            CU_Ticket(["CU11: Emitir Comprobante PDF"])
            CU_Garantia(["CU32: Aplicar Garantía / 1° Service"])
            CU_Anular(["CU12: Anular Venta y Restituir Stock"])
            
            CU_Venta -.->|"include"| CU_Ticket
            CU_Garantia -.->|"extend"| CU_Venta
            CU_Anular -.->|"extend"| CU_Venta
        end

        subgraph ModTaller["Subsistema 2: Taller Mecánico (Kanban)"]
            direction TB
            CU_Kanban(["CU14: Gestionar Tablero Kanban"])
            CU_Orden(["CU13: Abrir Orden de Reparación"])
            CU_Repuesto(["CU15: Imputar Repuestos y Mano de Obra"])
            CU_Entrega(["CU16: Finalizar y Entregar Rodado"])

            CU_Kanban -.->|"include"| CU_Orden
            CU_Repuesto -.->|"extend"| CU_Kanban
            CU_Entrega -.->|"extend"| CU_Kanban
        end

        subgraph ModClientes["Subsistema 3: Clientes y Rodados"]
            direction TB
            CU_Cliente(["CU01: Registrar Cliente / Consumidor Final"])
            CU_Bici(["CU07: Registrar Bicicleta en Taller"])
            CU_Historia(["CU09: Consultar Historia Clínica"])

            CU_Bici -.->|"extend"| CU_Cliente
            CU_Historia -.->|"extend"| CU_Bici
        end

        subgraph ModStock["Subsistema 4: Inventario y Proveedores"]
            direction TB
            CU_Stock(["CU18: Consultar Stock y Alertas"])
            CU_Ajuste(["CU17: Ajuste Manual de Kardex"])
            CU_Prov(["CU29: Administrar Proveedores (CUIT)"])
            CU_PagoProv(["CU30: Registrar Pago a Proveedor"])

            CU_PagoProv -.->|"extend"| CU_Prov
            CU_Ajuste -.->|"extend"| CU_Stock
        end

        subgraph ModSeguridad["Subsistema 5: Administración y Auditoría"]
            direction TB
            CU_Dashboard(["CU20: Consultar Dashboard y Balances"])
            CU_Usuarios(["CU23: Gestionar Usuarios y Roles"])
            CU_Auditoria(["CU28: Auditar Bitácora Inmutable"])
            CU_Backup(["CU35: Descargar Respaldo SQL"])

            CU_Auditoria -.->|"extend"| CU_Dashboard
            CU_Backup -.->|"extend"| CU_Auditoria
        end

    end

    %% Asociaciones de Actores a Subsistemas
    ActEmpleado --> CU_Venta
    ActEmpleado --> CU_Kanban
    ActEmpleado --> CU_Cliente
    ActEmpleado --> CU_Stock

    ActAdmin --> CU_Anular
    ActAdmin --> CU_Ajuste
    ActAdmin --> CU_Prov
    ActAdmin --> CU_PagoProv
    ActAdmin --> CU_Dashboard

    ActSuperadmin --> CU_Usuarios
    ActSuperadmin --> CU_Auditoria
    ActSuperadmin --> CU_Backup

    %% Estilos de Nodos
    style ActSuperadmin fill:#F1F5F9,stroke:#475569,stroke-width:2px,color:#0F172A
    style ActAdmin fill:#F1F5F9,stroke:#475569,stroke-width:2px,color:#0F172A
    style ActEmpleado fill:#F1F5F9,stroke:#475569,stroke-width:2px,color:#0F172A

