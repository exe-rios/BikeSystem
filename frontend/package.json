{
  "name": "frontend",
  "private": true,
  "main": "dist-electron/main.js",
  "version": "1.0.0",
  "description": "Sistema de gestión integral para bicicleterías",
  "author": "BikeSystem Team",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:backend": "pnpm --filter backend build",
    "build": "tsc -b && vite build",
    "dist": "pnpm build:backend && pnpm build && electron-builder --win",
    "dist:publish": "pnpm build:backend && pnpm build && electron-builder --win --publish always",
    "dist:dir": "pnpm build:backend && pnpm build && electron-builder --win --dir",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.55.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.11.18",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tslib": "^2.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^0.29.1"
  },
  "build": {
    "appId": "com.bikesystem.app",
    "productName": "BikeSystem",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "exe-rios",
        "repo": "BikeSystem"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/server.cjs",
        "to": "backend/server.cjs"
      },
      {
        "from": "../backend/.env.example",
        "to": "backend/.env.example"
      }
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BikeSystem",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico"
    }
  }
}
